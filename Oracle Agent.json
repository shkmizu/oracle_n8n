    {
      "parameters": {
        "jsCode": "// n8n Code Node (Node.js)\n// Input: JSON with a single property \"text\"\n// Output: One item per \"ARQX...\" section\n\n// Get input text\nconst input = $json[\"text\"];\n\n// Split by ARQ but keep the \"ARQ\" prefix in each section\nconst sections = input.split(/(?=ARQ\\d+)/);\n\n// Map each section into its own item\nreturn sections\n    .map(section => section.trim())\n    .filter(section => section.length > 0)\n    .map(section => {\n        return { json: { topic: section } };\n    });\n"
      },
